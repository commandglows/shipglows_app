{
  "name": "@shipglows/managed-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "test": "tsx --test test/**/*.test.ts",
    "smoke:providers": "tsx scripts/provider-smoke.ts",
    "smoke:operator-workspace": "tsx scripts/operator-workspace-smoke.ts",
    "backup:sqlite": "tsx scripts/backup-operational-store.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.4.0",
    "@agentclientprotocol/sdk": "1.3.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@vercel/sandbox": "3.0.0",
    "fastify": "5.10.0",
    "jose": "^6.2.7",
    "just-bash": "3.2.0",
    "node-pty": "^1.1.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/async-retry": "1.4.9",
    "@types/node": "22.20.1",
    "@types/ws": "^8.18.1",
    "eslint": "10.7.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
