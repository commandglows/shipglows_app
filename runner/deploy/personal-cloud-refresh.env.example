# Copy to ~/.config/shipglows/personal-cloud-refresh.env with mode 0600.
# This file contains no provider secret; it only locates the ShipGlows CLI and
# its private generated state.
SHIPGLOWS_ROOT=/home/REPLACE_OPERATOR/shipglows
SHIPGLOWS_CLOUD_MODE=true
SHIPGLOWS_PREVIEW_DOMAIN=preview.shipglows.com
SHIPGLOWS_CLI_PROJECT_CATALOG_FILE=/home/REPLACE_OPERATOR/.local/state/shipglows/cli-project-catalog.v1.json
SHIPGLOWS_USER_CADDY_ENABLED=true
SHIPGLOWS_USER_CADDY_BIND=127.0.0.1
SHIPGLOWS_USER_CADDY_PORT=8080
