# Copy to ~/.config/shipglows/runner.env with mode 0600. This is a shell env
# file sourced by run-runner.sh; keep real identifiers and mappings off Git.
RUNNER_ENV=production
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3210
RUNNER_DB_PATH=/home/REPLACE_OPERATOR/.local/share/shipglows-runner/runner.sqlite
RUNNER_ALLOWED_ORIGINS=https://app.shipglows.com

# Required production identity boundary. Membership UIDs are private deployment
# configuration even though Firebase project/browser identifiers may be public.
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID

RUNNER_PERSONAL_CLOUD_ENABLED=true
RUNNER_PERSONAL_CLOUD_APP_ORIGIN=https://app.shipglows.com
RUNNER_PERSONAL_CLOUD_TENANT_ID=ten_personal
# Every valid Firebase user can sign in and receives an isolated personal space.
# Only UIDs in this server-owned map receive access to the managed project catalog.
# `mutate` includes read access and is required for Editor and Terminal.
RUNNER_PERSONAL_CLOUD_PROJECT_MEMBERS='{"REPLACE_EXACT_FIREBASE_UID":{"shipglows":"mutate"}}'
RUNNER_CLOUD_PROJECT_CATALOG_PATH=/home/REPLACE_OPERATOR/.local/state/shipglows/cli-project-catalog.v1.json
RUNNER_CLOUD_ALLOWED_ROOTS=/home/REPLACE_OPERATOR/projects
RUNNER_PREVIEW_DOMAIN=shipglows.com

# Required in production Personal Cloud. The runner may invoke only tmux as
# this dedicated unprivileged account; it never forwards its own environment.
RUNNER_OPERATOR_WORKSPACE_USER=shipglows-workspace

# Keep disabled until each server-owned provider is configured and proved.
GITHUB_ENABLED=false
CODEX_ENABLED=false
EVE_ENABLED=false

# Optional private error reporting. When enabled, the runner sends only one
# stable failure code plus bounded release/environment identity; no PII,
# breadcrumbs, stack, request, path, project, conversation, prompt or tags.
SENTRY_ENABLED=false
# SENTRY_DSN=https://REPLACE_PUBLIC_KEY@REPLACE_HOST/REPLACE_PROJECT
# SENTRY_RELEASE=runner-REPLACE_COMMIT

# Operator-only terminal gateway. Replace the complete JSON value in
# the private server env; no path or tmux name is returned to Flutter.
# RUNNER_OPERATOR_WORKSPACES='{"prj_replace":{"cwd":"/home/REPLACE_OPERATOR/projects/example","tmuxSession":"shipglows-example"}}'

# Explicit bounded execution defaults.
RUNNER_MAX_CONCURRENT_RUNS_PER_TENANT=2
RUNNER_MAX_RUN_DURATION_MS=900000
