# Store the real file on the server with owner-only permissions. Do not commit it.
RUNNER_ENV=production
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3210
RUNNER_DB_PATH=/home/claude/.local/share/shipglows-runner/runner.sqlite
RUNNER_ALLOWED_ORIGINS=https://app.shipglows.com

# Required: production startup fails closed without this identity boundary.
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Personal Cloud stays opt-in. The UID, tenant and user are exact server-owned
# identifiers; Flutter never selects a tenant and never receives private paths.
RUNNER_PERSONAL_CLOUD_ENABLED=false
# RUNNER_PERSONAL_CLOUD_APP_ORIGIN=https://app.shipglows.com
# RUNNER_PERSONAL_CLOUD_FIREBASE_UID=your-exact-firebase-uid
# RUNNER_PERSONAL_CLOUD_TENANT_ID=ten_personal
# RUNNER_PERSONAL_CLOUD_USER_ID=usr_owner
# RUNNER_CLOUD_PROJECT_CATALOG_PATH=/home/claude/.local/state/shipglows/cli-project-catalog.v1.json
# RUNNER_CLOUD_ALLOWED_ROOTS=/home/claude/projects
# RUNNER_PREVIEW_DOMAIN=preview.shipglows.com

# Keep disabled until the server-owned GitHub App secret is configured.
GITHUB_ENABLED=false
CODEX_ENABLED=false
EVE_ENABLED=false

# Optional operator-only terminal gateway. The app receives only opaque session
# capabilities; these server paths and tmux names never leave the runner.
# RUNNER_OPERATOR_WORKSPACES={"prj_example":{"cwd":"/srv/shipglows/projects/example","tmuxSession":"shipglows-example"}}
