---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import { pathFor } from "../i18n/ui";

const locale = "en";

const families = [
  ["Business", "Use these when you want the agent to think in offer, growth, ROI, funnel, or buyer terms."],
  ["Content", "Use these when you want the agent to improve clarity, CTA, FAQ handling, repurposing, or discoverability."],
  ["Governance", "Use these when you want the agent to follow the canonical source, reduce drift, and respect ownership."],
  ["Execution", "Use these when you want tighter quality, proof, scope, and routing discipline."],
  ["System", "Use these when the conversation is about ShipGlows itself rather than the current project repo."]
];

const combos = [
  ["#offer #cta #clarity", "Make the value proposition and next action obvious."],
  ["#partner #growth #roi", "Push toward the highest-leverage business move."],
  ["#founder #growth #clarity", "Treat the user as a business owner and optimize for useful decisions."],
  ["#shipglows-owner #partner #no-drift", "Treat ShipGlows as a portfolio asset and avoid drifting across scope."],
  ["#end-user #clarity #quality", "Make the solution easier and safer for normal users."],
  ["#faq #trust #clarity", "Answer objections directly without losing credibility."],
  ["#canon #drift #single-source", "Repair the source of truth instead of patching duplicates."],
  ["#shipglows #proof #contract", "Work on ShipGlows itself and strengthen doctrine or proofability."]
];

const executionPostures = [
  ["#local", "Permit proportionate local builds, tests, and other proof when the owning workflow needs them; it does not force unnecessary work."],
  ["#nolocal", "Keep inspection and bounded edits available, but defer builds, tests, lint, typechecks, installation, runtime workloads, commits, pushes, deployments, and external writes."],
  ["#ci", "Imply #nolocal and record existing CI as the deferred proof target, without authorizing a push, workflow dispatch, deployment, or any remote write."]
];
---

<BaseLayout
  title="Focus Tags | ShipGlows"
  description="A lightweight cheatsheet for steering ShipGlows with simple tags instead of rewriting long prompts."
>
  <main class="page-shell">
    <NavBar />

    <section class="section" id="business-recenter-tags">
      <div class="section-heading">
        <p class="eyebrow">Focus Tags</p>
        <h1 class="page-title">Steer the AI with simple, fast tags.</h1>
        <p>
          When you do not want to rewrite the whole brief, use a small tag pack
          to recenter the agent on the right business, content, or governance
          posture. These tags are lightweight. They do not replace the normal
          owner-skill routing.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/docs#recommended-combos">See recommended combos</a>
          <a class="button button-secondary" href="https://github.com/commandglows/shipglows/blob/main/shipglows_data/technical/operator-guides/focus-tags-cheatsheet.md">Open the Markdown cheatsheet</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="doc-grid">
        {families.map(([title, body]) => (
          <article class="doc-card">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="execution-posture-tags">
      <div class="section-heading">
        <p class="eyebrow">Execution Posture Tags</p>
        <h2>Choose a proof environment without changing the workflow owner.</h2>
        <p>These three tags are transversal controls, not modes. <code>#local</code> conflicts with <code>#nolocal</code> and <code>#ci</code>; <code>#nolocal #ci</code> is valid. They may accompany any agent command, but never grant mutation or remote-action authority.</p>
      </div>
      <div class="doc-grid">
        {executionPostures.map(([tag, body]) => (
          <article class="doc-card"><h3><code>{tag}</code></h3><p>{body}</p></article>
        ))}
      </div>
      <div class="docs-panel"><div><h3>Examples</h3><p><code>sg-development feature checkout #local</code><br /><code>sg-bug fix payment callback #nolocal</code><br /><code>sg-engineering verify checkout #ci</code><br /><code>shipglows auto #ci until=18:00</code></p></div><div class="docs-links"><span class="docs-link"><code>auto ⇒ #nolocal</code></span><span class="docs-link"><code>auto #local ⇒ invalid</code></span></div></div>
    </section>

    <section class="section" id="system-recenter-tags">
      <div class="section-heading">
        <p class="eyebrow">Quick Combos</p>
        <h2>Start from a proven pack instead of inventing one every time.</h2>
      </div>
      <div class="doc-grid">
        {combos.map(([tags, body]) => (
          <article class="doc-card">
            <h3><code>{tags}</code></h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <p class="eyebrow">Next Step</p>
        <h2>Use tags when you want faster recentering, not heavier prompting.</h2>
        <p>
          For the full public reference, jump back to the docs overview or the
          Markdown cheatsheet.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor("/docs", locale)}>Open the docs overview</a>
          <a class="button button-secondary" href="https://github.com/commandglows/shipglows/blob/main/shipglows_data/technical/operator-guides/focus-tags-cheatsheet.md">Open the full cheatsheet</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
