---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import { pathFor } from "../../i18n/ui";

const locale = "fr";

const families = [
  ["Business", "À utiliser quand vous voulez que l’agent pense en offre, croissance, ROI, funnel ou décisionnaire."],
  ["Contenu", "À utiliser quand vous voulez améliorer la clarté, le CTA, les FAQ, le repurposing ou la découvrabilité."],
  ["Gouvernance", "À utiliser quand vous voulez la source canonique, moins de dérive et plus de respect de l’ownership."],
  ["Exécution", "À utiliser quand vous voulez plus de qualité, de preuve, de scope et de discipline de routage."],
  ["Système", "À utiliser quand la conversation porte sur ShipGlows lui-même et non sur le projet courant."]
];

const combos = [
  ["#offer #cta #clarity", "Rendre la proposition de valeur et l’action suivante évidentes."],
  ["#partner #growth #roi", "Pousser vers le mouvement business le plus utile."],
  ["#founder #growth #clarity", "Traiter l’utilisateur comme un owner business et optimiser les décisions utiles."],
  ["#shipglows-owner #partner #no-drift", "Traiter ShipGlows comme un actif de portefeuille et éviter la dérive de scope."],
  ["#end-user #clarity #quality", "Rendre la solution plus simple et plus sûre pour un utilisateur normal."],
  ["#faq #trust #clarity", "Répondre directement aux objections sans perdre en crédibilité."],
  ["#canon #drift #single-source", "Réparer la source de vérité au lieu de patcher des doublons."],
  ["#shipglows #proof #contract", "Travailler sur ShipGlows lui-même et renforcer la doctrine ou la preuve."]
];

const executionPostures = [
  ["#local", "Permet les builds, tests et autres preuves locales proportionnées lorsque le workflow owner en a besoin, sans imposer de travail inutile."],
  ["#nolocal", "Conserve l’inspection et les modifications bornées, mais diffère builds, tests, lint, typechecks, installations, workloads runtime, commits, pushs, déploiements et écritures externes."],
  ["#ci", "Implique #nolocal et désigne la CI existante comme cible de preuve différée, sans autoriser push, déclenchement de workflow, déploiement ni autre écriture distante."]
];
---

<BaseLayout
  title="Tags de recentrage | ShipGlows"
  description="Une cheatsheet légère pour guider ShipGlows avec des tags simples au lieu de réécrire de longs prompts."
  locale={locale}
  canonicalPath="/fr/focus-tags"
  alternatePath="/focus-tags"
>
  <main class="page-shell">
    <NavBar locale={locale} currentPath="/focus-tags" />

    <section class="section" id="business-recenter-tags">
      <div class="section-heading">
        <p class="eyebrow">Tags de recentrage</p>
        <h1 class="page-title">Guidez l’IA avec des tags simples et rapides.</h1>
        <p>
          Quand vous ne voulez pas réécrire tout le brief, utilisez un petit
          pack de tags pour remettre l’agent dans la bonne posture business,
          contenu ou gouvernance. Ces tags sont légers. Ils ne remplacent pas
          le routage normal par owner skill. Ils ne remplacent pas non plus les
          profils nommés : <code>%Ariane</code> active un profil, alors que
          <code>#Adhesion</code> reste un tag de focus.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor("/docs", locale)}>Voir les combos recommandés</a>
          <a class="button button-secondary" href="https://github.com/commandglows/shipglows/blob/main/shipglows_data/technical/operator-guides/focus-tags-cheatsheet.md">Ouvrir la cheatsheet Markdown</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="doc-grid">
        {families.map(([title, body]) => (
          <article class="doc-card">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="execution-posture-tags">
      <div class="section-heading">
        <p class="eyebrow">Tags de posture d’exécution</p>
        <h2>Choisissez l’environnement de preuve sans changer le métier owner.</h2>
        <p>Ces trois tags sont des contrôles transversaux, pas des modes. <code>#local</code> entre en conflit avec <code>#nolocal</code> et <code>#ci</code> ; <code>#nolocal #ci</code> est valide. Ils peuvent accompagner toute commande d’agent, mais n’accordent jamais d’autorité de modification ou d’action distante.</p>
      </div>
      <div class="doc-grid">
        {executionPostures.map(([tag, body]) => (
          <article class="doc-card"><h3><code>{tag}</code></h3><p>{body}</p></article>
        ))}
      </div>
      <div class="docs-panel"><div><h3>Exemples</h3><p><code>sg-development feature checkout #local</code><br /><code>sg-bug fix payment callback #nolocal</code><br /><code>sg-engineering verify checkout #ci</code><br /><code>shipglows auto #ci until=18:00</code></p></div><div class="docs-links"><span class="docs-link"><code>auto ⇒ #nolocal</code></span><span class="docs-link"><code>auto #local ⇒ invalide</code></span></div></div>
    </section>

    <section class="section" id="system-recenter-tags">
      <div class="section-heading">
        <p class="eyebrow">Combinaisons rapides</p>
        <h2>Partez d’un pack éprouvé plutôt que d’en inventer un à chaque fois.</h2>
      </div>
      <div class="doc-grid">
        {combos.map(([tags, body]) => (
          <article class="doc-card">
            <h3><code>{tags}</code></h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <p class="eyebrow">Étape suivante</p>
        <h2>Utilisez les tags pour recentrer plus vite, pas pour écrire des prompts plus longs.</h2>
        <p>
          Pour la référence publique complète, retournez à la vue docs ou à la
          cheatsheet Markdown.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor("/docs", locale)}>Ouvrir la vue docs</a>
          <a class="button button-secondary" href="https://github.com/commandglows/shipglows/blob/main/shipglows_data/technical/operator-guides/focus-tags-cheatsheet.md">Ouvrir la cheatsheet complète</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
