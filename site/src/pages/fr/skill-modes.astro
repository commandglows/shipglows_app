---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import { publicDomains, publicSkillCatalog } from "../../data/publicSkillCatalog";
import { pathFor } from "../../i18n/ui";

const locale = "fr";
const domainCopy: Record<string, string> = { "Start here": "COMMENCER ICI", Create: "CRÉER", Quality: "QUALITÉ", Publish: "PUBLIER", "Grow audience": "DÉVELOPPER L’AUDIENCE", Govern: "GOUVERNER", Organize: "ORGANISER" };
---

<BaseLayout title="Modes ShipGlows | Catalogue des métiers publics" description="Le catalogue ShipGlows sur une ligne : un routeur, treize métiers publics et leurs modes." locale={locale} canonicalPath="/fr/skill-modes" alternatePath="/skill-modes">
  <main class="page-shell">
    <NavBar locale={locale} currentPath="/skill-modes" />
    <section class="section"><div class="section-heading"><p class="eyebrow">Guide de lancement</p><h1 class="page-title">Choisissez un résultat, pas une chaîne de commandes.</h1><p>Commencez par <code>shipglows &lt;instruction&gt;</code> lorsque vous ne connaissez pas l’owner. Un métier public ne questionne que ce qu’il ne peut pas apprendre sûrement depuis le contexte, puis porte le travail jusqu’à l’implémentation, la preuve et la clôture.</p></div></section>
    <section class="section"><div class="pricing-grid"><article class="price-card"><p class="eyebrow">Une question à la fois</p><h2>Clarifier uniquement les décisions matérielles.</h2><p>Le produit visé, une promesse publique, une permission, un coût, la sécurité ou une portée irréversible peuvent nécessiter votre décision. Les détails d’implémentation et les handoffs internes restent le travail de ShipGlows.</p></article><article class="price-card accent-card"><p class="eyebrow">Ownership de A à Z</p><h2>Ne lancez pas vous-même l’étape interne suivante.</h2><p>Spec, readiness, checks, preuve navigateur, recherche et gates de release existent toujours, mais le métier owner les choisit et les exécute lorsque c’est nécessaire.</p></article></div></section>
    <section class="section"><div class="docs-panel"><div><p class="eyebrow">Raccourcis experts Codex</p><h2>Des routes courtes, le même ownership métier.</h2><p><code>shipglows explore|spec|status|resume</code> ouvre un mode expert de <code>sg-planning</code> ; <code>build</code> appartient à <code>sg-development</code> ; <code>fix</code> à <code>sg-bug</code> ; <code>test|browser</code> à <code>sg-engineering</code> ; et <code>ship|deploy|prod</code> à <code>sg-release</code>. <code>verify</code> conserve le spécialiste explicitement visé. Seul <code>core</code> bascule toute la demande vers la maintenance du système ShipGlows.</p></div><div class="docs-links"><span class="docs-link"><code>alias → mode métier → moteur interne</code></span></div></div></section>
    {publicDomains.map((domain) => { const skills = publicSkillCatalog.filter((skill) => skill.domain === domain); return skills.length > 0 && <section class="section"><div class="section-heading"><p class="eyebrow">{domainCopy[domain]}</p><h2>{domain === "Start here" ? "Le routeur" : "Métiers publics"}</h2></div><div class="role-list">{skills.map((skill) => <div class="role-row"><code>{skill.name}</code><span><strong>{skill.purpose}</strong><br /><span>Modes : <code>{skill.modes}</code></span></span></div>)}</div></section>; })}
    <section class="section"><div class="cta-panel"><p class="eyebrow">sg-help</p><h2>Utilisez <code>sg-help mode</code> pour cette carte publique.</h2><p>Ouvrez le catalogue expert pour voir les raccourcis rattachés aux métiers et l’inventaire des moteurs internes. Les moteurs numériques de lifecycle et les spécialistes restent réels, mais ne sont pas des choix publics par défaut.</p><div class="hero-actions"><a class="button button-primary" href={pathFor("/skills", locale)}>Parcourir les métiers</a><a class="button button-secondary" href={pathFor("/docs", locale)}>Lire la doctrine</a></div></div></section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
