---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import NavBar from "../../../components/NavBar.astro";
import SkillCard from "../../../components/SkillCard.astro";
import { publicDomains, publicSkillCatalog } from "../../../data/publicSkillCatalog";
import { pathFor } from "../../../i18n/ui";

const locale = "fr";
const domainCopy: Record<string, string> = {
  "Start here": "Commencer ici",
  Create: "CRÉER",
  Quality: "QUALITÉ",
  Publish: "PUBLIER",
  "Grow audience": "DÉVELOPPER L’AUDIENCE",
  Govern: "GOUVERNER",
  Organize: "ORGANISER"
};
const entries = await getCollection("skills");
const publicSkills = publicSkillCatalog.map((publicSkill) => ({ publicSkill, entry: entries.find((entry) => entry.id === publicSkill.slug) })).filter((item) => item.entry);
---

<BaseLayout title="Skills ShipGlows | Métiers publics" description="Un routeur et treize métiers pour faire avancer un résultat de A à Z sans micro-manager les étapes." locale={locale} canonicalPath="/fr/skills" alternatePath="/skills">
  <main class="page-shell">
    <NavBar locale={locale} currentPath="/skills" />
    <section class="section"><div class="section-heading">
      <p class="eyebrow">Catalogue des skills</p>
      <h1 class="page-title">Un routeur. Treize métiers. Pas de micro-management du workflow.</h1>
      <p>Décrivez le résultat attendu. ShipGlows résout le projet, le produit, la surface et la fonctionnalité lorsque le contexte le permet ; il ne pose une question que lorsqu’une décision change réellement le travail, puis l’exécute jusqu’à la preuve et la clôture.</p>
    </div></section>
    <section class="section"><div class="cta-panel">
      <p class="eyebrow">Le réflexe</p>
      <h2><code>shipglows &lt;instruction&gt;</code> est la seule commande à retenir.</h2>
      <p>Appelez un métier directement si vous connaissez déjà l’owner. Sinon, exprimez l’objectif : les moteurs internes de spec, checks, preuve navigateur, recherche et clôture restent derrière le métier responsable.</p>
      <div class="hero-actions"><a class="button button-secondary" href={pathFor("/skill-modes", locale)}>Voir les métiers et leurs modes</a></div>
    </div></section>
    {publicDomains.map((domain) => {
      const skills = publicSkills.filter((item) => item.publicSkill.domain === domain);
      return skills.length > 0 && <section class="section"><div class="section-heading"><p class="eyebrow">{domainCopy[domain]}</p><h2>{domain === "Start here" ? "Laissez ShipGlows choisir le métier." : `${skills.length} métier${skills.length > 1 ? "s" : ""} public${skills.length > 1 ? "s" : ""}.`}</h2></div><div class="skill-grid">{skills.map(({ publicSkill, entry }) => <SkillCard href={`/skills/${entry!.id}`} title={publicSkill.name} category={domainCopy[publicSkill.domain]} tagline={entry!.data.tagline} summary={publicSkill.purpose} relatedSkills={[]} featured={publicSkill.slug === "shipglows"} />)}</div></section>;
    })}
    <section class="section"><div class="docs-panel"><div><p class="eyebrow">Besoin d’un plan ?</p><h2><code>sg-help mode</code> montre le catalogue public ; le catalogue expert reste disponible sans encombrer le parcours par défaut.</h2><p>Les helpers runtime existent toujours, mais ils sont choisis par le métier owner au lieu de devenir des commandes concurrentes.</p></div><div class="docs-links"><a class="docs-link" href={pathFor("/skill-modes", locale)}>Modes publics</a><a class="docs-link" href={pathFor("/docs", locale)}>Vue documentation</a></div></div></section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
