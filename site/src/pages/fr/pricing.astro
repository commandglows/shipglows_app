---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import { pathFor } from "../../i18n/ui";

const locale = "fr";
---

<BaseLayout
  title="ShipGlows | Frontière produit et commerciale"
  description="ShipGlows est un logiciel autonome, pas une offre de services. Le SaaS Cockpit reste une possibilité future, pas une offre actuelle."
  locale={locale}
  canonicalPath="/fr/pricing"
  alternatePath="/pricing"
>
  <main class="page-shell">
    <NavBar locale={locale} currentPath="/pricing" />

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Frontière produit</p>
        <h1 class="page-title">ShipGlows est un logiciel, pas une entreprise de services.</h1>
        <p>
          La promesse de partenaire business est portée par le produit autonome :
          contexte gouverné, jugement utile, métiers responsables et preuves
          observables. Le mot « partenaire » ne cache aucune offre de conseil
          ou d’implémentation.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="pricing-grid">
        <article class="price-card">
          <p class="eyebrow">Disponible aujourd’hui</p>
          <h2>Le produit ShipGlows</h2>
          <p>
            Évaluez et utilisez ShipGlows grâce à son dépôt, sa documentation,
            ses métiers, ses contrats de gouvernance et ses outils de livraison.
          </p>
        </article>

        <article class="price-card accent-card">
          <p class="eyebrow">Possible plus tard</p>
          <h2>Un SaaS Cockpit distinct</h2>
          <p>
            Cockpit pourra éventuellement devenir le produit SaaS construit sur
            cette direction. Il n’existe pas aujourd’hui, n’est pas vendu et
            n’est pas présenté comme disponible.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <p class="eyebrow">Commencez par le produit</p>
        <h2>Inspectez ce que ShipGlows peut prouver aujourd’hui.</h2>
        <p>
          Le dépôt et la documentation montrent le comportement du produit, son
          modèle de gouvernance et la frontière de preuve derrière la promesse.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={pathFor("/docs", locale)}>Parcourir les docs</a>
          <a class="button button-secondary" href="https://github.com/commandglows/shipglows">Ouvrir GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
