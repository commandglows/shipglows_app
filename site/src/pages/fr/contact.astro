---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";

const locale = "fr";
---

<BaseLayout
  title="Contact ShipGlows"
  description="Comment discuter, évaluer ou contribuer au produit ShipGlows."
  locale={locale}
  canonicalPath="/fr/contact"
  alternatePath="/contact"
>
  <main class="page-shell">
    <NavBar locale={locale} currentPath="/contact" />

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Contact</p>
        <h1 class="page-title">Évaluez le produit, partagez des preuves ou contribuez.</h1>
        <p>
          ShipGlows vise les builders qui ressentent déjà le coût du contexte
          perdu, des passages de relais faibles et des boucles agent fragiles.
          Commencez par les docs et le dépôt, puis utilisez GitHub pour discuter
          du produit, signaler un problème ou proposer une amélioration.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="contact-grid">
        <article class="doc-card">
          <h3>Meilleure façon d’évaluer le produit</h3>
          <p>
            Apportez un vrai problème de workflow : reconstruction répétée du
            contexte, passages de relais faibles, dérive entre docs et
            implémentation ou opérations serveur désordonnées.
          </p>
        </article>

        <article class="doc-card">
          <h3>Ce que ShipGlows n’est pas</h3>
          <p>
            ShipGlows ne vend ni conseil, ni diagnostic, ni mission
            d’implémentation, ni accompagnement humain. « Partenaire » décrit le
            comportement du logiciel, pas un service vendu derrière lui.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <p class="eyebrow">Points d’entrée actuels</p>
        <h2>Le dépôt et les docs sont les premières surfaces de contact.</h2>
        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/commandglows/shipglows">Ouvrir GitHub</a>
          <a class="button button-secondary" href="/fr/docs">Lire les docs</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
