---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import SkillCard from "../../components/SkillCard.astro";
import { publicDomains, publicSkillCatalog } from "../../data/publicSkillCatalog";

const entries = await getCollection("skills");
const publicSkills = publicSkillCatalog.map((publicSkill) => ({
  publicSkill,
  entry: entries.find((entry) => entry.id === publicSkill.slug)
})).filter((item) => item.entry);
---

<BaseLayout
  title="ShipGlows Skills | A métier-first workflow catalog"
  description="Start with one plain-language instruction, then let one of 13 ShipGlows métiers carry the work from clarity to proof."
>
  <main class="page-shell">
    <NavBar />

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Skills catalog</p>
        <h1 class="page-title">One router. Thirteen métiers. No lifecycle micromanagement.</h1>
        <p>
          ShipGlows starts from the outcome you want, not a command you have to
          remember. It uses project context to resolve the product, surface, and
          feature; asks only for a material decision; then carries the work from
          clarification through proof and closure.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <p class="eyebrow">The default</p>
        <h2><code>shipglows &lt;instruction&gt;</code> is the only command you need to remember.</h2>
        <p>
          Use a métier directly when you already know the owner. Otherwise,
          describe the result in plain language. Internal engines handle specs,
          checks, browser proof, research, and closure behind that owner; they
          are not default choices you need to orchestrate yourself.
        </p>
        <div class="hero-actions">
          <a class="button button-secondary" href="/skill-modes">See every public métier and its modes</a>
        </div>
      </div>
    </section>

    {publicDomains.map((domain) => {
      const skills = publicSkills.filter((item) => item.publicSkill.domain === domain);
      return skills.length > 0 && (
        <section class="section">
          <div class="section-heading">
            <p class="eyebrow">{domain}</p>
            <h2>{domain === "Start here" ? "Let ShipGlows choose the métier." : `${skills.length} public métier${skills.length > 1 ? "s" : ""}.`}</h2>
          </div>
          <div class="skill-grid">
            {skills.map(({ publicSkill, entry }) => (
              <SkillCard
                href={`/skills/${entry!.id}`}
                title={publicSkill.name}
                category={publicSkill.domain}
                tagline={entry!.data.tagline}
                summary={publicSkill.purpose}
                relatedSkills={[]}
                featured={publicSkill.slug === "shipglows"}
              />
            ))}
          </div>
        </section>
      );
    })}

    <section class="section">
      <div class="docs-panel">
        <div>
          <p class="eyebrow">Need a map?</p>
          <h2><code>sg-help mode</code> shows the public catalog; the expert catalog stays available without crowding the default.</h2>
          <p>
            Runtime helpers remain documented for people who need them, but they
            are selected internally by the public owner skill rather than shown
            as competing first commands.
          </p>
        </div>
        <div class="docs-links">
          <a class="docs-link" href="/skill-modes">Public modes</a>
          <a class="docs-link" href="/docs">Documentation overview</a>
          <a class="docs-link" href="https://github.com/dianedef/ShipGlows/tree/main/skills">Skills on GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
