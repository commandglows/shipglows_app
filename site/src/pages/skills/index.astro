---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import NavBar from "../../components/NavBar.astro";
import SkillCard from "../../components/SkillCard.astro";
import { publicDomains, publicSkillCatalog } from "../../data/publicSkillCatalog";

const entries = await getCollection("skills");
const publicSkills = publicSkillCatalog.map((publicSkill) => ({
  publicSkill,
  entry: entries.find((entry) => entry.id === publicSkill.slug)
})).filter((item) => item.entry);
---

<BaseLayout
  title="ShipGlows Métiers | Business-aware ownership through proof"
  description="Start with a business or product outcome, then let one of 13 ShipGlows métiers carry the work from governed context to proof."
>
  <main class="page-shell">
    <NavBar />

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Skills catalog</p>
        <h1 class="page-title">One business-aware partner. Thirteen accountable métiers.</h1>
        <p>
          ShipGlows starts from the outcome you want, connects it to governed
          business and product truth, and chooses the métier best placed to own
          it. Material choices stay yours; specialist mechanics do not become
          another workflow for you to supervise.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
          <p class="eyebrow">The partnership entrypoint</p>
          <h2><code>shipglows &lt;outcome&gt;</code> is the only first move you need to remember.</h2>
          <p>
          Describe the business or product result in plain language. ShipGlows
          resolves context, challenges material gaps, recommends a direction
          when evidence supports one, and assigns the accountable métier.
          Internal engines remain behind that owner.
        </p>
        <div class="hero-actions">
          <a class="button button-secondary" href="/skill-modes">See every public métier and its modes</a>
        </div>
      </div>
    </section>

    {publicDomains.map((domain) => {
      const skills = publicSkills.filter((item) => item.publicSkill.domain === domain);
      return skills.length > 0 && (
        <section class="section">
          <div class="section-heading">
            <p class="eyebrow">{domain}</p>
            <h2>{domain === "Start here" ? "Let ShipGlows choose the métier." : `${skills.length} public métier${skills.length > 1 ? "s" : ""}.`}</h2>
          </div>
          <div class="skill-grid">
            {skills.map(({ publicSkill, entry }) => (
              <SkillCard
                href={`/skills/${entry!.id}`}
                title={publicSkill.name}
                category={publicSkill.domain}
                tagline={entry!.data.tagline}
                summary={publicSkill.purpose}
                relatedSkills={[]}
                featured={publicSkill.slug === "shipglows"}
              />
            ))}
          </div>
        </section>
      );
    })}

    <section class="section">
      <div class="docs-panel">
        <div>
          <p class="eyebrow">Need to inspect the system?</p>
          <h2>The public catalog shows who owns outcomes; the docs show what governs their judgment.</h2>
          <p>
            Runtime helpers remain documented for people who need them, but they
            serve the métier owner rather than competing with the business
            outcome as your first decision.
          </p>
        </div>
        <div class="docs-links">
          <a class="docs-link" href="/skill-modes">Public modes</a>
          <a class="docs-link" href="/docs">Documentation overview</a>
          <a class="docs-link" href="https://github.com/commandglows/shipglows/tree/main/skills">Skills on GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
