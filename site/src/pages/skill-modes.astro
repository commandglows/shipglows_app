---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import { publicDomains, publicSkillCatalog } from "../data/publicSkillCatalog";
---

<BaseLayout title="ShipGlows Modes | The public métier catalog" description="The one-line ShipGlows catalog: one router, thirteen public métiers, and the modes that select their work.">
  <main class="page-shell">
    <NavBar />
    <section class="section"><div class="section-heading">
      <p class="eyebrow">Skill launch guide</p>
      <h1 class="page-title">Choose an outcome, not a chain of commands.</h1>
      <p>Start with <code>shipglows &lt;instruction&gt;</code> when you do not know the owner. A public métier asks only what it cannot learn safely from context, then owns the journey through implementation, proof, documentation impact, and closure.</p>
    </div></section>
    <section class="section"><div class="pricing-grid">
      <article class="price-card"><p class="eyebrow">One question at a time</p><h2>Clarify only material decisions.</h2><p>Product choice, public claim, permission, cost, security posture, or irreversible scope can need your decision. Implementation mechanics and internal handoffs are ShipGlows’s job.</p></article>
      <article class="price-card accent-card"><p class="eyebrow">A to Z ownership</p><h2>Do not launch the next internal step yourself.</h2><p>Specs, readiness, checks, browser proof, research, and release gates remain available as expert tools, but the owning métier selects and runs them when they are needed.</p></article>
    </div></section>
    <section class="section"><div class="docs-panel"><div>
      <p class="eyebrow">Codex expert shortcuts</p>
      <h2>Short routes, same métier ownership.</h2>
      <p><code>shipglows explore|spec|status|resume</code> enters an expert <code>sg-planning</code> mode; <code>build</code> enters <code>sg-development</code>; <code>fix</code> enters <code>sg-bug</code>; <code>test|browser</code> enters <code>sg-engineering</code>; and <code>ship|deploy|prod</code> enters <code>sg-release</code>. <code>verify</code> preserves an explicit specialist owner. <code>core</code> alone switches the whole request to ShipGlows-system maintenance.</p>
    </div><div class="docs-links"><span class="docs-link"><code>alias → métier mode → internal engine</code></span></div></div></section>
    {publicDomains.map((domain) => {
      const skills = publicSkillCatalog.filter((skill) => skill.domain === domain);
      return skills.length > 0 && <section class="section"><div class="section-heading"><p class="eyebrow">{domain}</p><h2>{domain === "Start here" ? "The router" : "Public métiers"}</h2></div><div class="role-list">{skills.map((skill) => <div class="role-row"><code>{skill.name}</code><span><strong>{skill.purpose}</strong><br /><span>Modes: <code>{skill.modes}</code></span></span></div>)}</div></section>;
    })}
    <section class="section"><div class="cta-panel">
      <p class="eyebrow">sg-help</p>
      <h2>Use <code>sg-help mode</code> for this public map.</h2>
      <p>Use its expert-catalog option to see owner-bound shortcuts and the internal engine inventory. Numeric lifecycle and specialist engines remain real, but they are not default public choices.</p>
      <div class="hero-actions"><a class="button button-primary" href="/skills">Browse métier pages</a><a class="button button-secondary" href="/docs">Read the workflow doctrine</a></div>
    </div></section>
  </main>
  <Footer />
</BaseLayout>
