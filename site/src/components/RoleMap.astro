---
const docs = [
  ["AGENT.md", "entrypoint for operators and automation"],
  ["shipflow_data/*", "project-local governance corpus for adopted repos"],
  ["shipflow_data/business/business.md", "who it is for and what value it carries"],
  ["shipflow_data/business/product.md", "workflow scope, targets, and non-goals"],
  ["shipflow_data/business/branding.md", "product voice and communication rules"],
  ["shipflow_data/business/gtm.md", "public positioning and objection handling"],
  ["shipflow_data/editorial/content-map.md", "content strategy and repurposing map"],
  ["shipflow_data/technical/architecture.md", "operating architecture and boundaries"],
  ["shipflow_data/technical/context.md", "technical context and repository map"],
  ["shipflow_data/technical/context-function-tree.md", "large file and dependency relationships"],
  ["shipflow_data/technical/guidelines.md", "execution conventions and safeguards"],
  ["shipflow_data/technical/README.md", "technical onboarding for contributors"]
];
---

<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Repository Map</p>
    <h2>Every document has one job.</h2>
    <p>
      ContentFlow App documentation is designed for quick operator orientation:
      concise context, explicit scope, and separate layers for business,
      technical, and workflow truth.
    </p>
  </div>

  <div class="role-list">
    {
      docs.map(([name, role]) => (
        <div class="role-row">
          <code>{name}</code>
          <span>{role}</span>
        </div>
      ))
    }
  </div>
</section>
