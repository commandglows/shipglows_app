---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ContentFlow App",
  description = "ContentFlow App is the authenticated operator shell for creating, reviewing, and scheduling content with offline continuity."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
