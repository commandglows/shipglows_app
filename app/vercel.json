{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "framework": null,
  "outputDirectory": "build/web",
  "installCommand": "bash ./scripts/vercel-install.sh",
  "buildCommand": "bash ./scripts/vercel-build.sh",
  "rewrites": [
    { "source": "/__/auth", "destination": "https://shipglows-cloud.firebaseapp.com/__/auth" },
    { "source": "/__/auth/(.*)", "destination": "https://shipglows-cloud.firebaseapp.com/__/auth/$1" },
    { "source": "/__/firebase/init.json", "destination": "https://shipglows-cloud.firebaseapp.com/__/firebase/init.json" },
    { "source": "/sign-in", "destination": "/sign-in/index.html" },
    { "source": "/sign-in/", "destination": "/sign-in/index.html" },
    { "source": "/sign-in/(.*)", "destination": "/sign-in/index.html" },
    { "source": "/sign-up", "destination": "/sign-up/index.html" },
    { "source": "/sign-up/", "destination": "/sign-up/index.html" },
    { "source": "/sign-up/(.*)", "destination": "/sign-up/index.html" },
    { "source": "/sso-callback", "destination": "/sso-callback/index.html" },
    { "source": "/sso-callback/", "destination": "/sso-callback/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
